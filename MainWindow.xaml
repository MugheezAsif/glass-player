<Window x:Class="GlassPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Player" Width="372" Height="232" MinWidth="292"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Bahnschrift">

  <!-- "Late-night vinyl, under glass":
       editorial serif title (Sitka Banner) · DIN details (Bahnschrift) · editor-mono numerals (Cascadia Mono)
       one dominant accent pulled from each album cover; everything else is glass and white. -->
  <Window.Resources>
    <FontFamily x:Key="Serif">Sitka Banner, Georgia</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <SolidColorBrush x:Key="Accent" Color="#FF7CF2A8"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FF0D0F14"/>
  </Window.Resources>

  <Grid x:Name="Root" Margin="16" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="RootScale"/>
        <!-- liquid elasticity: the card leans and stretches toward the cursor -->
        <ScaleTransform x:Name="ElasticScale"/>
        <TranslateTransform x:Name="ElasticShift"/>
      </TransformGroup>
    </Grid.RenderTransform>

    <!-- soft floating shadow -->
    <Border x:Name="Shadow" CornerRadius="30" Background="#59000000">
      <Border.CacheMode><BitmapCache/></Border.CacheMode>
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45"/>
      </Border.Effect>
    </Border>

    <!-- Clear liquid glass: we capture what's behind the card and blur it ourselves (perfect rounded corners). -->
    <Grid x:Name="Card">
      <!-- all glass background layers, baked into one cached picture (redrawn only when the backdrop or accent changes) -->
      <Grid x:Name="Glass" CacheMode="BitmapCache">
      <!-- the backdrop arrives already blurred, refracted at the edges and chromatically split (LiquidGlass.cs) -->
      <Image x:Name="Backdrop" Margin="-28" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
      <!-- over a bright background the glass darkens a touch -->
      <Rectangle x:Name="OverLightDim" Fill="Black" Opacity="0" IsHitTestVisible="False"/>

      <!-- smoke: keeps white type legible over bright windows -->
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A0B0C14" Offset="0"/>
            <GradientStop Color="#6B06070D" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- album aura: the cover's colour glows through the glass behind the sleeve -->
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.2,0.32" GradientOrigin="0.2,0.32" RadiusX="0.62" RadiusY="0.95">
            <GradientStop x:Name="AuraA0" Color="#6B7CF2A8" Offset="0"/>
            <GradientStop x:Name="AuraA1" Color="#1F7CF2A8" Offset="0.55"/>
            <GradientStop x:Name="AuraA2" Color="#007CF2A8" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.95,1.05" GradientOrigin="0.95,1.05" RadiusX="0.55" RadiusY="0.8">
            <GradientStop x:Name="AuraB0" Color="#405A8CFF" Offset="0"/>
            <GradientStop x:Name="AuraB1" Color="#005A8CFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- fine frosted grain (static tile, costs nothing per frame) -->
      <Rectangle x:Name="Grain" Opacity="0.045" IsHitTestVisible="False"/>

      <!-- glare across the slab -->
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush GradientOrigin="0.05,0.05" Center="0.1,0.1" RadiusX="0.8" RadiusY="0.95">
            <GradientStop Color="#24FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.6"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      </Grid>

      <!-- hover / press glow from the top edge -->
      <Rectangle x:Name="HoverSheen" Opacity="0" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="1.1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Viewbox Stretch="Uniform">
        <Grid Width="340" Height="200">

          <!-- ── top: vinyl sleeve + record, and the titles ── -->
          <Canvas Width="340" Height="200" ClipToBounds="False">
            <!-- record: tucked behind the sleeve; slides out and spins while music plays -->
            <Grid x:Name="Record" Canvas.Left="25" Canvas.Top="25" Width="78" Height="78" Opacity="0"
                  RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
              <!-- cached once (sharp at 2x); spinning then only rotates the cached picture -->
              <Grid.CacheMode><BitmapCache RenderAtScale="2"/></Grid.CacheMode>
              <Grid.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="RecordSpin"/>
                  <TranslateTransform x:Name="RecordSlide"/>
                </TransformGroup>
              </Grid.RenderTransform>
              <Ellipse>
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#FF1A1B22" Offset="0"/>
                    <GradientStop Color="#FF0B0B0F" Offset="0.7"/>
                    <GradientStop Color="#FF050507" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.5"/></Ellipse.Effect>
              </Ellipse>
              <!-- grooves -->
              <Ellipse Margin="4" Stroke="#14FFFFFF" StrokeThickness="0.6"/>
              <Ellipse Margin="8" Stroke="#10FFFFFF" StrokeThickness="0.6"/>
              <Ellipse Margin="12" Stroke="#14FFFFFF" StrokeThickness="0.6"/>
              <Ellipse Margin="16" Stroke="#0DFFFFFF" StrokeThickness="0.6"/>
              <Ellipse Margin="20" Stroke="#12FFFFFF" StrokeThickness="0.6"/>
              <!-- sheen: two opposite light wedges, so the spin is visible -->
              <Ellipse>
                <Ellipse.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                    <GradientStop Color="#2EFFFFFF" Offset="0.38"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1FFFFFFF" Offset="0.64"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                  </LinearGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <!-- label = the cover art, with a spindle hole -->
              <Ellipse x:Name="RecordLabel" Width="28" Height="28" Fill="{StaticResource Accent}"/>
              <Ellipse Width="28" Height="28" Stroke="#40000000" StrokeThickness="0.8"/>
              <Ellipse Width="3.4" Height="3.4" Fill="#FF0B0B0F"/>
            </Grid>

            <!-- sleeve slot (the crisp cover image sits on top of this, outside the Viewbox) -->
            <Grid x:Name="ArtHost" Canvas.Left="22" Canvas.Top="22" Width="84" Height="84" Cursor="Hand"
                  ToolTip="Open Spotify" MouseLeftButtonDown="Art_Click" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="ArtScale"/></Grid.RenderTransform>
              <Border CornerRadius="14" Background="#55000000">
                <Border.CacheMode><BitmapCache/></Border.CacheMode>
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.45"/></Border.Effect>
              </Border>
              <Border CornerRadius="14">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF23263A" Offset="0"/>
                    <GradientStop Color="#FF101119" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="26"
                           Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Canvas>

          <!-- titles -->
          <Grid x:Name="TextPanel" Margin="140,22,22,0" Height="84" VerticalAlignment="Top">
            <Grid.RenderTransform><TranslateTransform x:Name="TextShift"/></Grid.RenderTransform>
            <StackPanel VerticalAlignment="Center">
              <!-- NOW PLAYING · pulsing accent dot -->
              <StackPanel x:Name="NowRow" Orientation="Horizontal" Margin="1,0,0,3">
                <Ellipse x:Name="NowDot" Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="NowText" Text="N O W   P L A Y I N G" FontFamily="{StaticResource Mono}" FontSize="7.5"
                           Foreground="#A6FFFFFF"/>
              </StackPanel>
              <!-- title: shadow is a blurred copy so the real glyphs stay sharp -->
              <Grid x:Name="TitleRow">
                <TextBlock Text="{Binding Text, ElementName=TitleText}" FontFamily="{StaticResource Serif}" FontSize="22"
                           FontWeight="SemiBold" Foreground="#80000000" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                  <TextBlock.CacheMode><BitmapCache/></TextBlock.CacheMode>
                  <TextBlock.Effect><BlurEffect Radius="8"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TitleText" Text="Nothing on the deck" FontFamily="{StaticResource Serif}" FontSize="22"
                           FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid x:Name="ArtistRow" Margin="1,1,0,0">
                <TextBlock Text="{Binding Text, ElementName=ArtistText}" FontSize="13" FontWeight="Light"
                           Foreground="#73000000" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                  <TextBlock.CacheMode><BitmapCache/></TextBlock.CacheMode>
                  <TextBlock.Effect><BlurEffect Radius="6"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="ArtistText" Text="Open Spotify to start" FontSize="13" FontWeight="Light"
                           Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- ── progress: 0:38 ───────●─── -2:50 ── -->
          <Grid x:Name="ProgressRow" Margin="22,120,22,0" Height="14" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PosText" Text="0:00" FontFamily="{StaticResource Mono}" FontSize="9.5"
                       Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
            <Grid x:Name="Track" Grid.Column="1" Height="14" Margin="4,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Track_Down" RenderTransformOrigin="0,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="TrackReveal"/></Grid.RenderTransform>
              <!-- cheap glow: a wider, faint accent bar under the fill (no effect to redraw) -->
              <Border x:Name="TrackGlow" Height="8" Width="0" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{StaticResource Accent}" Opacity="0.28" IsHitTestVisible="False"/>
              <Border x:Name="TrackBar" Height="3" CornerRadius="1.5" Background="#38FFFFFF" VerticalAlignment="Center">
                <Border x:Name="TrackFill" Width="0" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource Accent}"/>
              </Border>
              <Ellipse x:Name="Knob" Width="9" Height="9" Fill="White" IsHitTestVisible="False"
                       HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.5"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <TextBlock x:Name="EndText" Grid.Column="2" Text="-0:00" FontFamily="{StaticResource Mono}" FontSize="9.5"
                       Foreground="#99FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          </Grid>

          <!-- accent glow under the play disc (a Canvas, so nothing clips it into a square) -->
          <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="128" Canvas.Top="121" Width="84" Height="84" Fill="{StaticResource Accent}" Opacity="0.55">
              <Ellipse.OpacityMask>
                <RadialGradientBrush>
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#55000000" Offset="0.4"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.OpacityMask>
            </Ellipse>
          </Canvas>

          <!-- ── controls ── -->
          <Grid Margin="22,144,22,0" Height="38" VerticalAlignment="Top">
            <Grid.CacheMode><BitmapCache RenderAtScale="2"/></Grid.CacheMode>
            <Grid.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35"/></Grid.Effect>

            <Button x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" Width="32" Height="32"
                    HorizontalAlignment="Left" Margin="-8.5,0,0,0" Click="Shuffle_Click" ToolTip="Shuffle">
              <Grid Width="32" Height="32">
                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Icons}" FontSize="14.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="ShuffleDot" Width="3.5" Height="3.5" Fill="{StaticResource Accent}" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
              </Grid>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Width="38" Height="38" Click="Prev_Click" ToolTip="Previous">
                <Path Stretch="Uniform" Height="13" Data="M0,0 H2.6 V14 H0 Z M13.5,0 L3.6,7 L13.5,14 Z"
                      StrokeLineJoin="Round" StrokeThickness="1.6"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>

              <!-- play: an accent-coloured disc, the one loud thing on the card -->
              <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="40" Height="40" Margin="14,0" Click="Play_Click">
                <Grid Width="38" Height="38">
                  <Ellipse Fill="{StaticResource Accent}"/>
                  <Ellipse>
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#1A000000" Offset="1"/>
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Stroke="#59FFFFFF" StrokeThickness="0.8"/>
                  <Path x:Name="PlayIcon" Stretch="Uniform" Height="13" Data="M0,0 L0,13 L11,6.5 Z" Margin="2.5,0,0,0"
                        StrokeLineJoin="Round" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"
                        Fill="{StaticResource OnAccent}" Stroke="{StaticResource OnAccent}">
                    <Path.RenderTransform><ScaleTransform x:Name="PlayScale"/></Path.RenderTransform>
                  </Path>
                  <Path x:Name="PauseIcon" Stretch="Uniform" Height="13" Data="M0,0 H3.6 V13 H0 Z M7.4,0 H11 V13 H7.4 Z"
                        StrokeLineJoin="Round" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5"
                        Fill="{StaticResource OnAccent}" Stroke="{StaticResource OnAccent}">
                    <Path.RenderTransform><ScaleTransform x:Name="PauseScale"/></Path.RenderTransform>
                  </Path>
                </Grid>
              </Button>

              <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Width="38" Height="38" Click="Next_Click" ToolTip="Next">
                <Path Stretch="Uniform" Height="13" Data="M0,0 L9.9,7 L0,14 Z M10.9,0 H13.5 V14 H10.9 Z"
                      StrokeLineJoin="Round" StrokeThickness="1.6"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
            </StackPanel>

            <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Width="32" Height="32"
                    HorizontalAlignment="Right" Margin="0,0,-9,0" Click="Pin_Click" ToolTip="Always on top">
              <Grid Width="32" Height="32">
                <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{StaticResource Icons}" FontSize="13.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse x:Name="PinDot" Width="3.5" Height="3.5" Fill="{StaticResource Accent}" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
              </Grid>
            </Button>
          </Grid>

          <!-- hide (appears on hover) -->
          <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Width="22" Height="22" Opacity="0"
                  IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                  Click="Close_Click" ToolTip="Hide until Spotify opens again  ·  Shift+click to quit">
            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="8"/>
          </Button>
        </Grid>
      </Viewbox>

      <!-- Cover art, on whole pixels outside the scaled layout so it is drawn pixel-for-pixel (sharp).
           Position, size and rounding are set in code to sit exactly over the sleeve slot. -->
      <Grid x:Name="ArtCrisp" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" CacheMode="BitmapCache"
            UseLayoutRounding="True" RenderTransformOrigin="0.5,0.5">
        <Image x:Name="ArtA" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="ArtB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="ArtRim" BorderThickness="1" BorderBrush="#40FFFFFF"/>
      </Grid>

      <!-- Glass edges, drawn in real pixels (not scaled) so they stay crisp at any size. -->
      <Border x:Name="RimGlow" BorderThickness="9" Opacity="0.5" IsHitTestVisible="False" CacheMode="BitmapCache">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9FFFFFF" Offset="0"/>
            <GradientStop Color="#40FFFFFF" Offset="0.25"/>
            <GradientStop Color="#05FFFFFF" Offset="0.55"/>
            <GradientStop Color="#2EFFFFFF" Offset="0.8"/>
            <GradientStop Color="#A6FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><BlurEffect x:Name="RimGlowBlur" Radius="9" RenderingBias="Quality"/></Border.Effect>
      </Border>

      <Border x:Name="RimFringe" BorderThickness="2" Margin="1.5" Opacity="0.7" IsHitTestVisible="False" CacheMode="BitmapCache">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#9966D9FF" Offset="0.12"/>
            <GradientStop Color="#00FFFFFF" Offset="0.3"/>
            <GradientStop Color="#00FFFFFF" Offset="0.62"/>
            <GradientStop Color="#B3FF5CCF" Offset="0.8"/>
            <GradientStop Color="#9966D9FF" Offset="0.9"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect><BlurEffect x:Name="RimFringeBlur" Radius="2.5" RenderingBias="Quality"/></Border.Effect>
      </Border>

      <Border x:Name="RimInner" BorderThickness="1" Margin="1" IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/>
            <GradientStop Color="#0FFFFFFF" Offset="0.22"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#0AFFFFFF" Offset="0.78"/>
            <GradientStop Color="#38FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>

      <!-- faint constant hairline, so the edge never disappears -->
      <Border x:Name="RimOuter" BorderThickness="1" BorderBrush="#38FFFFFF" IsHitTestVisible="False"/>

      <!-- light rim: angle, position and strength follow the cursor (LiquidGlass.cs) -->
      <Border x:Name="RimLight" BorderThickness="1.5" IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush x:Name="RimLightBrush" StartPoint="0.15,0.15" EndPoint="0.85,0.85">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop x:Name="RimLight1" Color="#4DFFFFFF" Offset="0.33"/>
            <GradientStop x:Name="RimLight2" Color="#BFFFFFFF" Offset="0.66"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
    </Grid>
  </Grid>
</Window>
